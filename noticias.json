name: Atualizar noticias da Radio Guaicui

on:
  workflow_dispatch:
  schedule:
    - cron: "*/15 * * * *"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar repositorio
        uses: actions/checkout@v4

      - name: Buscar e misturar noticias
        shell: bash
        run: |
          python - <<'PY'
          import json
          import urllib.request
          import xml.etree.ElementTree as ET
          from datetime import datetime, timezone

          FEEDS = [
              {
                  "categoria": "AGÊNCIA BRASIL",
                  "url": "https://agenciabrasil.ebc.com.br/rss/ultimasnoticias/feed.xml"
              },
              {
                  "categoria": "CNN BRASIL",
                  "url": "https://cnnbrasil.com.br/feed"
              },
              {
                  "categoria": "ESPORTES",
                  "url": "https://www.mg.superesportes.com.br/rss/noticias/futebol/futebol-nacional/rss.xml"
              },
              {
                  "categoria": "ESPORTES",
                  "url": "https://www.mg.superesportes.com.br/rss/noticias/mais-esportes/rss.xml"
              },
              {
                  "categoria": "MINAS GERAIS",
                  "url": "https://news.google.com/rss/search?q=Minas%20Gerais&hl=pt-BR&gl=BR&ceid=BR:pt-419"
              }
          ]

          def local_name(tag):
              if "}" in tag:
                  return tag.split("}", 1)[1]
              return tag

          def get_child(element, name):
              for child in list(element):
                  if local_name(child.tag).lower() == name.lower():
                      return child
              return None

          def get_text(element, name):
              child = get_child(element, name)
              if child is None:
                  return ""
              return (child.text or "").strip()

          def get_link(element):
              child = get_child(element, "link")

              if child is None:
                  return ""

              # RSS comum: <link>https://...</link>
              if child.text and child.text.strip():
                  return child.text.strip()

              # Atom: <link href="...">
              return child.attrib.get("href", "").strip()

          def baixar(feed):
              req = urllib.request.Request(
                  feed["url"],
                  headers={
                      "User-Agent": "Radio Guaicui News Bot/1.0"
                  }
              )

              with urllib.request.urlopen(req, timeout=30) as response:
                  data = response.read()

              root = ET.fromstring(data)

              encontrados = []

              # RSS e Atom
              for element in root.iter():
                  if local_name(element.tag).lower() not in ("item", "entry"):
                      continue

                  titulo = get_text(element, "title")
                  link = get_link(element)

                  if titulo and link:
                      encontrados.append({
                          "categoria": feed["categoria"],
                          "title": titulo,
                          "link": link
                      })

              return encontrados

          todas = []

          for feed in FEEDS:
              try:
                  noticias = baixar(feed)

                  # No máximo 8 notícias de cada fonte
                  noticias = noticias[:8]

                  print(
                      f"{feed['categoria']}: "
                      f"{len(noticias)} noticias encontradas"
                  )

                  todas.append(noticias)

              except Exception as erro:
                  print(
                      f"ERRO em {feed['categoria']}: {erro}"
                  )
                  todas.append([])

          # -------------------------------------------------
          # MISTURA AUTOMÁTICA DAS FONTES
          # -------------------------------------------------

          misturadas = []
          maior = max((len(lista) for lista in todas), default=0)

          for posicao in range(maior):
              for lista in todas:
                  if posicao < len(lista):
                      misturadas.append(lista[posicao])

          # -------------------------------------------------
          # REMOVE DUPLICADAS
          # -------------------------------------------------

          resultado = []
          links_vistos = set()

          for noticia in misturadas:
              link = noticia["link"]

              if link in links_vistos:
                  continue

              links_vistos.add(link)

              resultado.append({
                  "title": noticia["title"],
                  "link": link,
                  "categoria": noticia["categoria"]
              })

          # Máximo de 40 notícias
          resultado = resultado[:40]

          dados = {
              "source": "Radio Guaicui - Noticias",
              "updated_at": datetime.now(timezone.utc).isoformat(),
              "items": resultado
          }

          with open("noticias.json", "w", encoding="utf-8") as arquivo:
              json.dump(
                  dados,
                  arquivo,
                  ensure_ascii=False,
                  indent=2
              )

          print("")
          print("====================================")
          print("NOTICIAS ATUALIZADAS")
          print("Total:", len(resultado))
          print("====================================")

          for noticia in resultado[:10]:
              print(
                  f"[{noticia['categoria']}] "
                  f"{noticia['title']}"
              )
          PY

      - name: Publicar noticias
        run: |
          git config user.name "Radio Guaicui Bot"
          git config user.email "actions@users.noreply.github.com"

          git add noticias.json

          git diff --cached --quiet || \
            git commit -m "Atualiza noticias automaticamente"

          git push
